# Smart Planter — Euregio Hackathon
# Copy to .env on the Raspberry Pi and adjust PI_HOST if needed.
TZ=Europe/Berlin
MQTT_PORT=1883
INFLUX_PORT=8086
WEB_PORT=8098
INFLUX_ORG=kololab
INFLUX_BUCKET=planter
INFLUX_USER=admin
INFLUX_PASSWORD=CHANGE_ME
INFLUX_TOKEN=CHANGE_ME
MQTT_USER=planter
MQTT_PASSWORD=CHANGE_ME
SECRET_KEY=CHANGE_ME
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=1272371648
ALERT_DRY_PCT=25
ALERT_DRY_MIN=20
ALERT_SILENT_MIN=5
ALERT_TANK_PCT=15
PUMP_SECONDS=20
PUMP_COOLDOWN_MIN=30
# A node is shown offline after this many seconds without telemetry (default 90).
NODE_OFFLINE_SEC=90
PUID=1000
PGID=1000

# Host helper (deploy/install-host-helper.sh generates this automatically)
HOST_HELPER_TOKEN=CHANGE_ME

# AI (optional; free tiers). Google AI Studio / OpenRouter / Groq / ModelScope.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=CHANGE_ME
AI_MODEL=gemini-3.8-flash
AI_VISION_MODEL=gemini-3.8-flash
AI_FALLBACKS=gemini-3.8-flash,gemini-flash-latest,gemini-3.6-flash,gemma-4-31b-it
AI_STT_MODEL=gemini-3.8-flash
AI_TTS_MODEL=gemini-3.8-flash-tts
AI_TTS_VOICE=Kore
