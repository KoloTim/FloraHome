# Copy this to secrets.yaml and fill in your values.
# secrets.yaml is gitignored and never leaves the machine.
wifi_ssid: "DEIN_WLAN_NAME"
wifi_password: "DEIN_WLAN_PASSWORT"
ap_password: "planter-fallback"
ota_password: "planter-ota"
mqtt_username: "planter"
mqtt_password: "AUS_DER_ENV_DATEI"
# Where the broker runs. When the nodes are on the same Wi-Fi as the Pi, use the
# Pi's LAN IP on that network (e.g. 192.168.0.104), NOT the hotspot address.
mqtt_broker: "192.168.0.104"
